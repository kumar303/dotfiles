#!/usr/bin/env bash
set -euo pipefail

file="$1"
start="$2"
line_count="$3"
width="$4"
end=$((start + line_count - 1))

bat \
  --color=always \
  --highlight-line "$start" \
  --line-range "$start:$end" \
  --paging=never \
  --style=numbers \
  --terminal-width "$width" \
  --theme=OneHalfLight \
  --wrap=never \
  "$file"
