[user]
    name = Kumar McMillan
    email = kumar.mcmillan@gmail.com
[core]
    editor = vim
    pager = delta
    excludesfile = /Users/kumar/.gitignore
[color]
    diff = auto
    status  = auto
    branch = auto
[alias]
    br = branch
    ci = commit
    co = checkout
    pp = !git remote prune origin && git pull
    st = status
    fix = "commit -a --amend -C HEAD"
    ri = rebase --interactive --autosquash HEAD~5
[push]
    default = current
[help]
    autocorrect = 1
[init]
    defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    light = true
